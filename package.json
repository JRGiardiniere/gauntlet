{
  "name": "gauntlet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "gauntlet": "bin/gauntlet.ts"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "bundle": "bun scripts/bundle.ts",
    "lint": "bun scripts/lint-house-style.ts",
    "live-gate": "bun scripts/live-gate.ts",
    "live-gate-compiled": "bun scripts/live-gate-compiled.ts",
    "test": "vitest run && sh scripts/install.test.sh",
    "test:upgrade-compiled": "bun run bundle && sh scripts/upgrade-compiled.test.sh dist/gauntlet",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@effect/platform-node": "4.0.0-rc.110",
    "effect": "4.0.0-rc.110",
    "just-bash": "3.3.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "4.0.0-rc.110",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "26.0.1",
    "madge": "^8.0.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.9"
  }
}
