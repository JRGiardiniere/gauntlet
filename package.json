{
  "name": "gauntlet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "gauntlet": "bin/gauntlet.ts"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "bundle": "bun scripts/bundle.ts",
    "lint": "bun scripts/lint-house-style.ts",
    "live-gate": "bun scripts/live-gate.ts",
    "live-gate-compiled": "bun scripts/live-gate-compiled.ts",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "bun --bun vitest run src/ && vitest run scripts/ .convoy/ && sh scripts/install.test.sh",
    "test:upgrade-compiled": "bun run bundle && sh scripts/upgrade-compiled.test.sh dist/gauntlet",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@effect/platform-node": "4.1.0",
    "@opencode/core": "2.3.2",
    "@opencode/sdk": "2.3.2",
    "@opencode/util": "2.3.2",
    "effect": "4.1.0",
    "just-bash": "3.6.1",
    "markdown-it": "15.0.3",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "@effect/vitest": "4.1.0",
    "@oxlint/plugins": "1.94.0",
    "@types/node": "26.6.6",
    "madge": "^8.0.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "effect": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./scripts/stubs/empty-package",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:./scripts/stubs/empty-package",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:./scripts/stubs/empty-package",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:./scripts/stubs/empty-package",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:./scripts/stubs/empty-package",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:./scripts/stubs/empty-package",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:./scripts/stubs/empty-package",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:./scripts/stubs/empty-package"
  }
}
