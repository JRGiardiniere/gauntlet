{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./.convoy/packs/typescript/oxlintrc.json",
    "./.convoy/packs/effect-house-rules/oxlintrc.json",
    "./.convoy/packs/anti-slop/oxlintrc.json",
    "./.convoy/packs/effect/oxlintrc.json"
  ],
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.mjs",
    ".convoy/**",
    "mod/types/**"
  ],
  "rules": {
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-useless-default-assignment": "off",
    "typescript/no-generated-empty-object-type": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-duplicate-type-constituents": "off",
    "anti-slop/require-readable-spacing": "off",
    "anti-slop-effect/no-manual-tagged-construction": "off",
    "anti-slop-effect/no-manual-tag-comparison": "off",
    "anti-slop-effect/no-service-constructor-imports": "off",
    "anti-slop/no-array-filter-map": "off"
  },
  "overrides": [
    {
      "files": ["mod/gauntlet/hooks/*.ts", "mod/platform.test.ts", "mod/engine.ts", "mod/session.ts", "mod/session.test.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/new-promise": "off"
      }
    },
    {
      // The hooks module ships as source and the host lets it import only
      // "claude-code" and its own files (the engine bundle), so Effect's
      // modules aren't available to it: `claude plugin validate` refuses an
      // "effect/…" import there, and the Mod doesn't load.
      "files": ["mod/gauntlet/hooks/*.ts"],
      "rules": {
        "effecttsgo/prefer-effect-array": "off",
        "effecttsgo/prefer-effect-record": "off",
        "effecttsgo/global-json": "off",
        "eslint/no-restricted-imports": ["error", { "patterns": [{ "group": ["effect", "effect/*", "@effect/*"], "message": "The host refuses a hooks module that imports anything but \"claude-code\" and its own files; reach Effect through ../../engine.ts." }] }]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.fixture.ts"],
      "rules": {
        "anti-slop-effect/no-manual-tag-comparison": "off"
      }
    },
    {
      "files": ["src/run/review-executor.ts", "src/cli/upgrade.ts", "src/harness/live-gate.ts", "mod/engine.ts"],
      "rules": {
        "effecttsgo/strict-effect-provide": "off"
      }
    },
    {
      "files": ["src/run/artifact.ts"],
      "rules": {
        "effecttsgo/any-unknown-in-error-context": "off"
      }
    }
  ]
}
