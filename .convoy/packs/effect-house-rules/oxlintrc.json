{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "house",
      "specifier": "./index.ts"
    }
  ],
  "rules": {
    "house/directive-reason": "error",
    "house/no-effect-promise": "error",
    "house/no-module-level-mutable-state": "error",
    "house/require-ts-extension-imports": "error",
    "house/retry-schedule-bounded": "error"
  },
  "overrides": [
    {
      "files": ["**/*.integration.ts", "**/*.fixture.ts", "scripts/**"],
      "rules": { "house/no-module-level-mutable-state": "off" }
    },
    {
      "files": ["**/*.integration.ts", "**/*.fixture.ts"],
      "rules": { "house/no-effect-promise": "off" }
    }
  ]
}
